---
// One chapter of the manual, laid out like Omarchy's: the chapters down the
// left, the wordmark and "MANUAL" on top, the chapter, then previous / next.
import { type Lang } from '../i18n';
import { manual } from '../lib/manual';
interface Props { lang: Lang; index: number }
const { lang, index } = Astro.props;
const chapters = manual(lang);
const ch = chapters[index];
const base = lang === 'en' ? '/manual/' : '/es/manual/';
const href = (i: number) => base + (chapters[i].slug ? chapters[i].slug + '/' : '');
const prev = index > 0 ? index - 1 : -1;
const next = index < chapters.length - 1 ? index + 1 : -1;
const L = lang === 'en' ? { chapters: 'Chapters', prev: 'Previous', next: 'Next' } : { chapters: 'Capítulos', prev: 'Anterior', next: 'Siguiente' };
---
<div class="wrap manual">
  <nav class="toc" aria-label={L.chapters}>
    <details open>
      <summary>{L.chapters}</summary>
      <ol>
        {chapters.map((c, i) => <li><a href={href(i)} aria-current={i === index ? 'page' : undefined}>{c.title}</a></li>)}
      </ol>
    </details>
  </nav>
  <article class="chapter">
    <header class="brand">
      <img src="/logo.svg" alt="Mutiny" width="460" height="128" />
      <p>MANUAL</p>
    </header>
    <h1>{ch.title}</h1>
    <div class="prose" set:html={ch.html} />
    <footer class="pager">
      {prev >= 0 ? <a class="prev" href={href(prev)}><small>{L.prev}</small>← {chapters[prev].title}</a> : <span></span>}
      {next >= 0 && <a class="next" href={href(next)}><small>{L.next}</small>{chapters[next].title} →</a>}
    </footer>
  </article>
</div>

<script>
  // on a phone the chapter list starts folded, so the chapter comes first
  if (matchMedia('(max-width: 860px)').matches) document.querySelector('.toc details')?.removeAttribute('open');
</script>

<style>
  .manual { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 48px; padding-block: 24px 72px; align-items: start; }
  .toc { position: sticky; top: 16px; max-height: calc(100vh - 32px); overflow-y: auto; font-size: 14px; }
  .toc summary { display: none; }
  .toc ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 1px; }
  .toc a { display: block; padding: 6px 10px; border-radius: 3px; color: var(--fg); text-decoration: none; }
  .toc a:hover { background: var(--surface); color: var(--strong); }
  .toc a[aria-current='page'] { background: var(--surface-2); color: var(--strong); font-weight: 700; box-shadow: inset 2px 0 0 var(--accent); }
  .chapter { max-width: 780px; }
  .brand { text-align: center; margin: 8px 0 36px; }
  .brand img { width: min(460px, 100%); height: auto; image-rendering: pixelated; }
  .brand p { margin: 10px 0 0; letter-spacing: 5px; font-size: 13px; color: var(--muted); }
  h1 { font-size: clamp(28px, 4.4vw, 40px); color: var(--accent); margin: 0 0 22px; }
  .prose :global(h2) { font-size: 22px; margin: 34px 0 12px; }
  .prose :global(h3) { font-size: 18px; margin: 28px 0 10px; }
  .prose :global(p) { margin: 0 0 16px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 16px; padding-left: 24px; }
  .prose :global(li) { margin: 5px 0; }
  .prose :global(li > ul), .prose :global(li > ol) { margin: 5px 0 8px; }
  .prose :global(li > p) { margin: 8px 0; }
  .prose :global(strong) { color: var(--strong); }
  .prose :global(blockquote) { margin: 0 0 18px; padding: 10px 16px; border-left: 3px solid var(--accent); background: var(--surface); }
  .prose :global(blockquote p) { margin: 0; }
  .prose :global(hr) { border: none; border-top: 1px solid var(--line); margin: 26px 0; }
  .prose :global(.table) { overflow-x: auto; margin: 0 0 20px; }
  .prose :global(table) { border-collapse: collapse; width: 100%; font-size: 14px; }
  .prose :global(th), .prose :global(td) { text-align: left; vertical-align: top; padding: 8px 10px; border-bottom: 1px solid var(--line); }
  .prose :global(th) { color: var(--strong); border-bottom-color: var(--faint); }
  .prose :global(:target) { animation: flash 1.6s ease; }
  @keyframes flash { from { background: var(--accent-soft); } to { background: transparent; } }
  .pager { display: flex; justify-content: space-between; gap: 20px; margin-top: 44px; padding-top: 18px; border-top: 1px solid var(--line); }
  .pager a { color: var(--fg); text-decoration: none; display: flex; flex-direction: column; gap: 2px; }
  .pager a:hover { color: var(--strong); }
  .pager small { font-size: 12px; color: var(--muted); letter-spacing: 1px; text-transform: uppercase; }
  .pager .next { text-align: right; margin-left: auto; }
  @media (max-width: 860px) {
    .manual { grid-template-columns: 1fr; gap: 12px; }
    .toc { position: static; max-height: none; }
    .toc summary { display: block; cursor: pointer; padding: 10px 12px; border: 1px solid var(--line); border-radius: 3px; color: var(--strong); }
    .toc ol { margin-top: 8px; }
  }
</style>
