---
import { V } from '../lib/build';
// The middle of the home page: what you write, the assistant, privacy, themes,
// free and open.
import { T, type Lang } from '../i18n';
import { THEMES } from '../data/themes';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang];
---
<section class="block" id="write">
  <div class="wrap">
    <p class="kicker">{t.write.kicker}</p>
    <h2>{t.write.title}</h2>
    <p class="lead">{t.write.sub}</p>
    <ul class="types">
      {t.write.types.map(([name, forms]) => <li><h3>{name}</h3><p>{forms}</p></li>)}
    </ul>
    <ul class="tools">
      {t.write.tools.map(([name, desc]) => <li><h3>{name}</h3><p>{desc}</p></li>)}
    </ul>
  </div>
</section>

<section class="block" id="assistant">
  <div class="wrap">
    <p class="kicker">{t.ai.kicker}</p>
    <h2>{t.ai.title}</h2>
    <p class="lead">{t.ai.sub}</p>
    <ul class="ai">
      {t.ai.items.map(([name, desc], i) => <li><span class="glyph" aria-hidden="true">{['⚑', '✦', '?', '›_'][i]}</span><h3>{name}</h3><p>{desc}</p></li>)}
    </ul>
    <p class="providers">{t.ai.providers}</p>
  </div>
</section>

<section class="block" id="privacy">
  <div class="wrap">
    <p class="kicker">{t.privacy.kicker}</p>
    <h2>{t.privacy.title}</h2>
    <p class="lead">{t.privacy.sub}</p>
    <div class="ledger">
      <div class="col stays"><h3>{t.privacy.staysTitle}</h3><ul>{t.privacy.stays.map((x) => <li>{x}</li>)}</ul></div>
      <div class="col leaves"><h3>{t.privacy.leavesTitle}</h3><ul>{t.privacy.leaves.map((x) => <li>{x}</li>)}</ul></div>
    </div>
    <p class="note">{t.privacy.note}</p>
  </div>
</section>

<section class="block" id="themes">
  <div class="wrap">
    <p class="kicker">{t.themes.kicker}</p>
    <h2>{t.themes.title}</h2>
    <p class="lead">{t.themes.sub}</p>
    <div class="theme-grid">
      {THEMES.map((th) => (
        <button type="button" class="tcard" data-theme-pick={th.id} style={`--c-bg:${th.bg};--c-fg:${th.fg};--c-strong:${th.strong};--c-ac:${th.accent}`}>
          <span class="mock" aria-hidden="true">
            <span class="bar"><i></i><i></i><i></i></span>
            <span class="page"><b>Words start mutinies</b><em></em><em></em><em class="short"></em><span class="mark">⚑</span></span>
            <span class="side"><em></em><em></em></span>
          </span>
          <span class="tname">{th.name}</span>
        </button>
      ))}
    </div>
    <!-- Omarchy: the desktop Mutiny follows, and the old laptop it was made on.
         The laptop's screen wears whatever theme the cards above picked. -->
    <div class="omarchy">
      <svg class="laptop" viewBox="0 0 240 150" aria-hidden="true">
        <rect class="lid" x="30" y="6" width="180" height="118" rx="8" />
        <rect class="scr" x="38" y="14" width="164" height="100" rx="2" />
        <rect class="bar" x="38" y="14" width="164" height="7" />
        <circle class="dot" cx="44" cy="17.5" r="1.6" /><circle class="dot" cx="50" cy="17.5" r="1.6" /><circle class="dot" cx="56" cy="17.5" r="1.6" />
        <rect class="txt strong" x="50" y="32" width="70" height="6" rx="1" />
        <rect class="txt" x="50" y="46" width="96" height="3" rx="1" />
        <rect class="txt" x="50" y="54" width="90" height="3" rx="1" />
        <rect class="txt" x="50" y="62" width="98" height="3" rx="1" />
        <rect class="txt" x="50" y="70" width="60" height="3" rx="1" />
        <rect class="ac" x="112" y="68.5" width="3" height="5" />
        <rect class="side" x="160" y="21" width="1" height="93" />
        <rect class="card" x="166" y="30" width="30" height="16" rx="1.5" />
        <rect class="card" x="166" y="50" width="30" height="16" rx="1.5" />
        <path class="base" d="M4 126h232l-10 14H14z" />
        <rect class="notch" x="104" y="126" width="32" height="3" rx="1.5" />
      </svg>
      <div class="om-text">
        <p class="kicker">{t.themes.omarchy.kicker} <i class="live" aria-hidden="true"></i></p>
        <p class="om-title">{t.themes.omarchy.title}</p>
        <p class="om-sub">{t.themes.omarchy.sub}</p>
        <p class="om-made">{t.themes.omarchy.made}</p>
        <p><a class="btn" href="https://omarchy.org">{t.themes.omarchy.link} →</a></p>
      </div>
    </div>
  </div>
</section>

<section class="block" id="free">
  <div class="wrap free">
    <div>
      <p class="kicker">{t.free.kicker}</p>
      <h2>{t.free.title}</h2>
      <p class="lead">{t.free.sub}</p>
      <p class="links"><a class="btn primary" href="https://github.com/worldmutiny/mutiny">{t.free.github}</a> <a class="btn" href="https://github.com/hughhowey/neo">{t.free.neo}</a></p>
    </div>
    <ul class="points">{t.free.points.map((p) => <li>{p}</li>)}</ul>
  </div>
</section>

<script is:inline src={`/js/theme-cards.js?v=${V}`} defer></script>

<style>
  .lead { color: var(--fg); max-width: var(--text); margin: -6px 0 30px; }
  h3 { font-size: 17px; margin: 0 0 6px; }
  p { margin: 0; }

  .types { list-style: none; padding: 0; margin: 0 0 34px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  .types li { border: 1px solid var(--line); background: var(--surface); border-radius: 4px; padding: 18px; }
  .types h3 { color: var(--accent); }
  .types p { font-size: 14px; color: var(--fg); }
  .tools { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 28px; }
  .tools li { border-top: 1px solid var(--line); padding-top: 16px; }
  .tools p { font-size: 14px; color: var(--muted); }

  .ai { list-style: none; padding: 0; margin: 0 0 26px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .ai li { border: 1px solid var(--line); border-radius: 4px; padding: 18px; background: var(--surface); }
  .glyph { display: inline-grid; place-items: center; min-width: 34px; height: 34px; padding: 0 6px; margin-bottom: 12px; border-radius: 3px; background: var(--accent-soft); color: var(--accent); font-weight: 700; }
  .ai p { font-size: 14px; color: var(--fg); }
  .providers { color: var(--muted); max-width: var(--text); font-size: 14.5px; }

  .ledger { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 18px; }
  .col { border: 1px solid var(--line); border-radius: 4px; padding: 20px 22px; }
  .col ul { margin: 10px 0 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  .col li { padding-left: 26px; position: relative; font-size: 15px; }
  .stays li::before { content: '■'; position: absolute; left: 2px; color: var(--strong); font-size: 12px; top: 3px; }
  .leaves li::before { content: '→'; position: absolute; left: 0; color: var(--accent); }
  .stays { background: var(--surface); }
  .note { color: var(--muted); font-size: 14px; max-width: var(--text); }
  .omarchy {
    display: grid; grid-template-columns: minmax(180px, 300px) 1fr; gap: clamp(20px, 4vw, 48px); align-items: center;
    margin-top: 36px; padding: clamp(20px, 3vw, 32px); border: 1px solid var(--line); border-left: 3px solid var(--accent); border-radius: 10px; background: var(--surface);
  }
  .om-text { display: flex; flex-direction: column; gap: 10px; }
  .om-text p { margin: 0; max-width: 62ch; }
  .om-text .kicker { display: flex; align-items: center; gap: 10px; }
  .live { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 0 var(--accent); animation: live 2s infinite; }
  @keyframes live { 70% { box-shadow: 0 0 0 8px transparent; } 100% { box-shadow: 0 0 0 0 transparent; } }
  .om-title { font-size: clamp(18px, 2.2vw, 22px); color: var(--strong); line-height: 1.35; }
  .om-sub { color: var(--muted); }
  .om-made { color: var(--fg); padding-top: 10px; border-top: 1px solid var(--line); }
  .om-text .btn { margin-top: 4px; }
  /* the laptop takes the colours of the theme in use */
  .laptop { width: 100%; height: auto; }
  .lid { fill: #2b2b30; stroke: #45454d; }
  .base { fill: #3a3a42; }
  .notch { fill: #24242a; }
  .scr { fill: var(--bg); transition: fill .4s; }
  .bar { fill: var(--surface-2); transition: fill .4s; }
  .dot { fill: var(--line); }
  .txt { fill: var(--fg); opacity: .75; transition: fill .4s; }
  .txt.strong { fill: var(--strong); opacity: 1; }
  .ac, .side { fill: var(--accent); transition: fill .4s; }
  .card { fill: var(--surface-2); stroke: var(--line); stroke-width: .5; }
  @media (max-width: 700px) { .omarchy { grid-template-columns: 1fr; } .laptop { max-width: 260px; } }
  @media (prefers-reduced-motion: reduce) { .live { animation: none; } }

  .theme-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-bottom: 18px; }
  .tcard { font: inherit; text-align: left; background: none; border: 1px solid var(--line); border-radius: 6px; padding: 10px; cursor: pointer; display: grid; gap: 10px; color: var(--fg); transition: border-color .15s, transform .15s; }
  .tcard:hover { border-color: var(--strong); transform: translateY(-2px); }
  .tcard[aria-pressed='true'] { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .tname { font-size: 14px; padding: 0 4px; }
  .mock { display: grid; grid-template-columns: 1fr 34%; grid-template-rows: 14px 1fr; aspect-ratio: 16 / 9; background: var(--c-bg); border-radius: 4px; overflow: hidden; }
  .bar { grid-column: 1 / -1; display: flex; gap: 6px; align-items: center; padding: 0 8px; border-bottom: 1px solid color-mix(in srgb, var(--c-fg) 15%, var(--c-bg)); }
  .bar i { width: 22px; height: 3px; background: color-mix(in srgb, var(--c-fg) 55%, var(--c-bg)); }
  .page { margin: 8px; padding: 8px 10px; background: color-mix(in srgb, var(--c-fg) 5%, var(--c-bg)); border: 1px solid color-mix(in srgb, var(--c-fg) 14%, var(--c-bg)); display: flex; flex-direction: column; gap: 5px; position: relative; }
  .page b { color: var(--c-strong); font-size: 10px; line-height: 1.2; }
  .page em { height: 4px; background: var(--c-fg); opacity: .8; }
  .page em.short { width: 55%; }
  .mark { position: absolute; right: 8px; bottom: 6px; font-size: 10px; color: var(--c-ac); }
  .side { margin: 8px 8px 8px 0; border-left: 2px solid var(--c-ac); padding: 6px; display: flex; flex-direction: column; gap: 5px; background: color-mix(in srgb, var(--c-fg) 7%, var(--c-bg)); }
  .side em { height: 3px; background: color-mix(in srgb, var(--c-fg) 60%, var(--c-bg)); }

  .free { display: grid; grid-template-columns: 1.6fr 1fr; gap: 40px; align-items: end; }
  .free h2 { font-size: clamp(26px, 4vw, 42px); margin: 0 0 18px; }
  .links { display: flex; gap: 12px; flex-wrap: wrap; }
  .points { list-style: none; padding: 0; margin: 0; display: grid; gap: 0; }
  .points li { border-top: 1px solid var(--line); padding: 12px 0; color: var(--strong); }

  @media (max-width: 900px) {
    .types, .theme-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tools, .ai { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 24px; }
    .free { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .types, .tools, .ai, .ledger, .theme-grid { grid-template-columns: 1fr; }
  }
</style>
